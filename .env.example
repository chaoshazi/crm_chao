# ---- 应用 ----
CRM_ENV=dev
CRM_LOG_LEVEL=INFO
CRM_TENANT_ID=default

# ---- 存储 ----
# sqlite = 本机零依赖（默认，适合开发与联调）；postgres = 生产
CRM_STORAGE=sqlite
CRM_SQLITE_PATH=data/crm.sqlite3
CRM_DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5433/crm
# 启动时按元数据建表（CREATE TABLE IF NOT EXISTS，可重复执行）
CRM_AUTO_MIGRATE=true

# ---- 安全 ----
# 生产必须改：人工登录令牌与密码摘要都依赖它
CRM_SECRET_KEY=dev-only-change-me
CRM_TOKEN_TTL_HOURS=12
# AI 能力层（D:\codex）用的服务账号令牌，填到那边的 AICRM_CRM_API_TOKEN
CRM_SERVICE_TOKEN=dev-service-token
CRM_SERVICE_ACTOR_ID=ai-agent

# ---- 初始化数据 ----
# 写入与 D:\codex 的 fake 模式同 ID 的演示数据，便于两边结果对比
CRM_SEED_DEMO=true
# 首次启动创建管理员账号（仅当 users 表为空）
CRM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CRM_BOOTSTRAP_ADMIN_PASSWORD=admin12345
CRM_BOOTSTRAP_ADMIN_NAME=系统管理员

# ---- 前端 ----
# true 且 web/dist 存在时，由 FastAPI 托管前端构建产物
CRM_SERVE_WEB=true
CRM_WEB_DIST_DIR=web/dist
CRM_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---- 分页与限制 ----
CRM_DEFAULT_PAGE_SIZE=50
CRM_MAX_PAGE_SIZE=200